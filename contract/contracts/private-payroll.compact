pragma language_version >= 0.23.0;

import CompactStandardLibrary;

/**
 * ============================================================================
 * Midnight Private Payroll - Level 3 Core Contract (Private Splits)
 * ============================================================================
 *
 * Privacy Model & Boundaries:
 *
 * 1. PUBLIC STATE:
 *    - `verification_count`: Total count of salary ceiling compliance checks.
 *    - `split_count`: Total count of recorded private payroll splits.
 *    - `payroll_cycle`: Current active payroll accounting cycle.
 *    - `split_commitments`: Cryptographic commitment set preventing duplicate splits.
 *
 * 2. PRIVATE WITNESS INPUT:
 *    - `get_salary_amount()`: Injected off-chain by the user/organization.
 *    - `get_split_nonce()`: High-entropy 32-byte blinding factor / secret salt.
 *
 * 3. WHAT THE CIRCUITS PROVE:
 *    - `verify_salary`: Prover has a valid salary: 0 < salary <= max_allowed_salary.
 *    - `record_private_split`:
 *        * 0 < salary <= max_allowed_salary.
 *        * derives commitment = persistent_hash(PrivatePayrollSplit { salary, nonce }).
 *        * guarantees commitment is not already a member of `split_commitments`.
 *        * records commitment in `split_commitments` on-chain.
 *        * increments `split_count` by 1.
 *
 * 4. WHAT IS DELIBERATELY NOT WRITTEN TO PUBLIC LEDGER:
 *    - The raw salary amount is NEVER stored on the public ledger.
 *    - The blinding nonce is NEVER stored on the public ledger.
 *    - Observers learn only that a valid split occurred and the public commitment.
 */

// Public ledger state
export ledger verification_count: Counter;
export ledger split_count: Counter;
export ledger payroll_cycle: Counter;
export ledger split_commitments: Set<Bytes<32>>;

// Private split record structure for commitment hashing
export struct PrivatePayrollSplit {
    salary: Uint<64>,
    nonce: Bytes<32>,
}

// Private witness functions
witness get_salary_amount(): Uint<64>;
witness get_split_nonce(): Bytes<32>;

// Public entrypoint circuit: validates the private salary against payroll constraints
export circuit verify_salary(max_allowed_salary: Uint<64>): [] {
    const salary = get_salary_amount();

    assert(salary > 0, "Salary amount must be strictly greater than zero");
    assert(salary <= max_allowed_salary, "Salary amount exceeds maximum payroll limit");

    verification_count.increment(1);
}

// Public entrypoint circuit: validates and commits a private payroll split
export circuit record_private_split(max_allowed_salary: Uint<64>): Bytes<32> {
    const salary = get_salary_amount();
    const nonce = get_split_nonce();

    assert(salary > 0, "Salary amount must be strictly greater than zero");
    assert(salary <= max_allowed_salary, "Salary amount exceeds maximum payroll limit");

    const split = PrivatePayrollSplit {
        salary: salary,
        nonce: nonce,
    };
    const commitment = disclose(persistentHash<PrivatePayrollSplit>(split));

    assert(!split_commitments.member(commitment), "Duplicate payroll split: commitment already recorded");

    split_commitments.insert(commitment);
    split_count.increment(1);

    return commitment;
}

// Public helper circuit: advances the payroll accounting cycle
export circuit advance_payroll_cycle(): [] {
    payroll_cycle.increment(1);
}

